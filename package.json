{
  "name": "sensory-sound",
  "version": "0.1.1",
  "description": "A small generative ambient sound engine for the browser: eleven synthesised layers, named soundscapes, slow fades and a safety limiter. No samples.",
  "license": "MIT",
  "author": "Jason Chao",
  "repository": { "type": "git", "url": "git+https://github.com/jason-chao/sensory-sound.git" },
  "homepage": "https://github.com/jason-chao/sensory-sound#readme",
  "keywords": ["web-audio", "generative", "ambient", "soundscape", "synthesis", "sensory"],
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepare": "npm run build",
    "test": "vitest run",
    "soundcheck": "node scripts/soundcheck.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
